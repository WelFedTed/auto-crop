{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WelFedTed/auto-crop/docs/testing/golden-label.schema.json",
  "title": "Auto Crop golden-set label",
  "description": "One label file per image. Labels are made blank-quad (never from the app's suggestion).",
  "type": "object",
  "required": ["schema_version", "image_sha256", "scene_id", "tier", "slices", "orientation_quarter_turns", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scene_id": { "type": "string", "minLength": 1, "description": "Shared by images of the same base document or background; used for scene-disjoint splits." },
    "tier": { "enum": ["golden", "dev"] },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "receipt-long", "thermal-fade", "partial-frame", "touching-items", "phone-document",
          "flatbed-single", "flatbed-multi", "general-photo", "heic-device", "negative"
        ]
      }
    },
    "orientation_quarter_turns": { "enum": [0, 1, 2, 3], "description": "Clockwise quarter turns needed to make the content upright." },
    "items": {
      "type": "array",
      "description": "One entry per document or photo. Empty for no-document negatives.",
      "items": {
        "type": "object",
        "required": ["quad"],
        "additionalProperties": false,
        "properties": {
          "quad": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "description": "Four corners, clockwise from the top-left of the upright item, in source-image pixels (may lie outside the frame for partial frames).",
            "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
          },
          "partial_frame": { "type": "boolean" },
          "curved": { "type": "boolean" }
        }
      }
    },
    "noise_floor_double_labelled": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
